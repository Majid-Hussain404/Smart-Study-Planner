# ==============================================================================
# SMART STUDY PLANNER - BACKEND ENVIRONMENT VARIABLES (.env)
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and fill in your actual values.
# NEVER commit your '.env' file to Git! It is already added to .gitignore.

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
APP_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Neon Pooled Connection String (Used for everyday API queries, connections pooled by Neon PgBouncer)
# Format: postgresql://[user]:[password]@[endpoint-id]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Direct (Unpooled) Connection String (Used for running migrations & schema changes)
# Format: postgresql://[user]:[password]@[endpoint-id].[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:your_password_here@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (FOR SIGNUP VERIFICATION & PASSWORD RESETS)
# ------------------------------------------------------------------------------
# In development, you can leave these blank (or use test mode: emails will log to the server console)
# In production, use your SMTP provider (SendGrid, Mailgun, Resend, Brevo, AWS SES, or Gmail App Password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Smart Study Planner <noreply@smartstudyplanner.com>"

# ------------------------------------------------------------------------------
# 5. AI RECOMMENDATION ENGINE (OPTIONAL)
# ------------------------------------------------------------------------------
# Provide your Google Gemini or OpenAI API key for intelligent study suggestions and topic breakdown
AI_API_KEY=your_gemini_or_openai_api_key_here

# ------------------------------------------------------------------------------
# 6. INITIAL OWNER SETUP (ONE-TIME CLI SETUP)
# ------------------------------------------------------------------------------
# Used only when running the one-time owner initialization CLI command: npm run seed:owner
OWNER_SETUP_SECRET=change_this_to_a_temporary_strong_secret_for_first_owner_setup
